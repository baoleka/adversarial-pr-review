{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verdict.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "round",
    "mode",
    "verdict",
    "reason",
    "escalations",
    "blocking_ids",
    "must_address_ids",
    "contested_ids",
    "open_fix_ids",
    "gate_summary",
    "lanes",
    "coverage",
    "cost",
    "snapshot_tree",
    "snapshot_commit",
    "merge_base",
    "base_ref",
    "single_family",
    "stale_base",
    "integrity",
    "replay_isolation",
    "toolchain",
    "state_hashes"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "enum": [
        "loop",
        "no-fix"
      ]
    },
    "verdict": {
      "enum": [
        "APPROVE",
        "REQUEST_CHANGES",
        "ESCALATE"
      ]
    },
    "reason": {
      "type": "string"
    },
    "escalations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition",
          "finding_ids",
          "detail",
          "decision_needed"
        ],
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detail": {
            "type": "string"
          },
          "decision_needed": {
            "type": "string"
          }
        }
      }
    },
    "blocking_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F-[0-9a-f]{12}$"
      }
    },
    "must_address_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F-[0-9a-f]{12}$"
      }
    },
    "contested_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F-[0-9a-f]{12}$"
      }
    },
    "open_fix_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F-[0-9a-f]{12}$"
      }
    },
    "gate_summary": {
      "type": "object"
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lane",
          "model",
          "effort",
          "status",
          "findings_raw",
          "kept",
          "rejected",
          "cost_usd",
          "tokens"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "lane": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "effort": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "failed",
              "timeout",
              "invalid",
              "dropped-budget",
              "skipped"
            ]
          },
          "findings_raw": {
            "type": [
              "integer",
              "null"
            ]
          },
          "kept": {
            "type": [
              "integer",
              "null"
            ]
          },
          "rejected": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cost_usd": {
            "type": "number",
            "minimum": 0
          },
          "tokens": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input",
              "output",
              "cache_read",
              "cache_write"
            ],
            "properties": {
              "input": {
                "type": "integer",
                "minimum": 0
              },
              "output": {
                "type": "integer",
                "minimum": 0
              },
              "cache_read": {
                "type": "integer",
                "minimum": 0
              },
              "cache_write": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_lines",
        "excluded_lines",
        "reviewed_lines",
        "ratio"
      ],
      "properties": {
        "changed_lines": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_lines": {
          "type": "integer",
          "minimum": 0
        },
        "reviewed_lines": {
          "type": "integer",
          "minimum": 0
        },
        "ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_usd",
        "budget_usd",
        "by_kind"
      ],
      "properties": {
        "total_usd": {
          "type": "number",
          "minimum": 0
        },
        "budget_usd": {
          "type": "number",
          "minimum": 0
        },
        "by_kind": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "snapshot_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "snapshot_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "merge_base": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "base_ref": {
      "type": "string"
    },
    "single_family": {
      "type": "boolean"
    },
    "stale_base": {
      "type": [
        "string",
        "null"
      ]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "violations"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "detail"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "replay_isolation": {
      "enum": [
        "docker",
        "bwrap",
        "none"
      ]
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claude",
        "python",
        "git"
      ],
      "properties": {
        "claude": {
          "type": [
            "string",
            "null"
          ]
        },
        "python": {
          "type": "string"
        },
        "git": {
          "type": "string"
        }
      }
    },
    "state_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
